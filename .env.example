# fin-monitoring — runtime config TEMPLATE. Copy to .env and fill. .env is gitignored.
# Postgres (dedicated container)
POSTGRES_USER=fin
POSTGRES_PASSWORD=__GENERATE__            # openssl rand -hex 24
POSTGRES_DB=fin_monitoring
# App
# NOTE: DATABASE_URL must use the same user, password, and database name as POSTGRES_* above
DATABASE_URL=postgres://fin:__GENERATE__@fin-monitoring-db:5432/fin_monitoring
JWT_SECRET=__GENERATE__                   # openssl rand -hex 32
