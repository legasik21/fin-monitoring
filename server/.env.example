# Copy this file to .env for LOCAL DEV (`npm run dev`).
# Production config lives in the compose-dir ../.env (see ../.env.example).
# .env is gitignored — never commit real secrets.

PORT=3001

# Postgres connection string (local dev).
DATABASE_URL=postgres://fin:fin@localhost:5432/fin_monitoring

# Password used to log into the app.
APP_PASSWORD=__REDACTED_see_offbox_env__

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__REDACTED_see_offbox_env__

# Long-lived key for the Apple Shortcut quick-add endpoint (X-API-Key header).
QUICK_ADD_TOKEN=__REDACTED_see_offbox_env__
