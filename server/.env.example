# Copy this file to .env for LOCAL DEV inside Docker.
# Production config lives in the compose-dir ../.env (see ../.env.example).
# .env is gitignored — never commit real secrets.

PORT=3001

# Postgres connection string (local dev inside docker with dev container).
# When running: docker network create fin-dev && docker run -d --name fin-monitoring-dev-db --network fin-dev -e POSTGRES_USER=fin -e POSTGRES_PASSWORD=fin -e POSTGRES_DB=fin_monitoring postgres:16-alpine
DATABASE_URL=postgres://fin:fin@fin-monitoring-dev-db:5432/fin_monitoring

# Secret used to sign JWTs. Generate a long random string, e.g.:
#   openssl rand -hex 32
JWT_SECRET=__GENERATE__
